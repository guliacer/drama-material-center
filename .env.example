# Relative paths are resolved from this repository.
MATERIAL_CENTER_WORKSPACE=./workspace

# Comma-separated external hostnames allowed to reach `npm run preview` behind a reverse proxy.
# Leave empty for local-only access. Example: drama.example.com,127.0.0.1
PREVIEW_ALLOWED_HOSTS=

# ===== Guli Identity OIDC 鉴权 =====
# 留空则完全关闭鉴权（适合本地开发）。生产环境需同时配置前端 VITE_ 变量与后端变量。
# 前端（构建时写入 JS，值是公开的，client_id 不是密钥）：
VITE_GULI_ISSUER=
VITE_GULI_DISCOVERY_URL=
VITE_GULI_CLIENT_ID=
VITE_GULI_REDIRECT_URI=
VITE_GULI_POST_LOGOUT_URI=
VITE_GULI_SCOPES=openid email profile
# 后端（运行时读取，通过 userinfo 端点校验 Bearer token）：
GULI_IDENTITY_ISSUER=
GULI_IDENTITY_USERINFO_URL=https://auth.guliacer.dpdns.org/me

